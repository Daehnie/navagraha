---
import Base from '../../layouts/Base.astro'
import ThemeSwitcher from '../../components/ThemeSwitcher.astro'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Beschreibungen stehen in src/i18n/, hier nur Struktur und Befehle.
const tools = [
  { key: 'tabby', name: 'Tabby', file: 'themes/tabby/navagraha.yaml',
    cmd: 'Settings → Config file\nSettings → Farbschema\nDarstellung → Terminal background: From color scheme' },
  { key: 'iterm2', name: 'iTerm2', file: 'themes/iterm2',
    cmd: 'Profiles → Colors → Color Presets\nUse different colors for light and dark mode' },
  { key: 'vscode', name: 'VS Code', file: 'themes/vscode/navagraha',
    cmd: 'cp -R navagraha ~/.vscode/extensions/\n⌘K ⌘T' },
  { key: 'vimbat', name: 'Vim & bat', file: 'themes/vim/navagraha.vim',
    cmd: 'cp navagraha.vim ~/.vim/colors/\ncolorscheme navagraha\nexport BAT_THEME=ansi' }
]
const repo = 'https://github.com/Daehnie/navagraha/tree/main/'
---
<Base title={`${t.themes.title} — Navagraha`} description={t.themes.lede}>
  <section class="wrap" style="border-top:0">
    <h2>{t.themes.title}</h2>
    <p>{t.themes.lede}</p>
    <ThemeSwitcher labels={t.variants} />
    <div class="steps">
      {tools.map(tool => (
        <div>
          <h3>{tool.name}</h3>
          <p>{t.themes.tools[tool.key]}</p>
          <pre class="mono">{tool.cmd}</pre>
          <p><a href={repo + tool.file}>{t.themes.download}</a></p>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .steps { display: grid; gap: var(--s6); margin-top: var(--s6); }
  @media (min-width: 46rem) { .steps { grid-template-columns: 1fr 1fr; gap: var(--s6); } }
  .steps h3 { margin: 0 0 var(--s1); }
  .steps p { margin: 0 0 var(--s2); font-size: .88rem; color: var(--ketu); }
  .steps pre { background: var(--surface); border: 1px solid var(--hl_med);
    border-radius: 8px; padding: var(--s3); font-size: .74rem; line-height: 1.7;
    letter-spacing: .016em; color: var(--subtle); white-space: pre-wrap;
    margin: 0 0 var(--s2); }

  @media (prefers-contrast: more) {
    .steps p { color: var(--subtle); }
    .steps pre { border-color: var(--hl_high); }
  }
</style>
