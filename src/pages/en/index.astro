---
import Base from '../../layouts/Base.astro'
import Derivation from '../../components/Derivation.astro'
import HueWheel from '../../components/HueWheel.astro'
import Strength from '../../components/Strength.astro'
import Grounds from '../../components/Grounds.astro'
import ContrastSpan from '../../components/ContrastSpan.astro'
import ContrastTable from '../../components/ContrastTable.astro'
import ThemeSwitcher from '../../components/ThemeSwitcher.astro'
import CodePreview from '../../components/CodePreview.astro'
import { getLangFromUrl, useTranslations, path } from '../../i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---
<Base title={`Navagraha — ${t.tagline}`} description={t.lede}>
  <header class="wrap">
    <h1>{t.tagline}</h1>
    <p class="sub">{t.lede}</p>
    <ThemeSwitcher labels={t.variants} systemLabel={t.systemLabel} systemNote={t.systemNote} />
  </header>

  <Derivation t={t} />

  <section class="wrap">
    <h2>{t.preview.title}</h2>
    <p>{t.preview.lede}</p>
    <CodePreview />
    <p class="go">
      <a class="cta" href={path('/themes', lang)}>{t.themes.title}</a>
      <a href={path('/palette', lang)}>{t.palette.title}</a>
    </p>
  </section>

  <section class="wrap method">
    <h2>{t.method.title}</h2>
    <h3>{t.method.intro.h}</h3>
    <p>{t.method.intro.p1}</p>
    <p>{t.method.intro.p2}</p>
    <h3>{t.method.hues.h}</h3><p>{t.method.hues.p}</p>
    <HueWheel><span slot="alt">{t.method.figures.wheelAlt}</span></HueWheel>
    <p class="bu">{t.method.figures.wheel}</p>

    <h3>{t.method.force.h}</h3><p>{t.method.force.p}</p>
    <Strength labels={t.method.figures} />
    <p class="bu">{t.method.figures.strength}</p>
    <ul class="cases">
      {t.method.force.cases.map(c => <li><b>{c.name}</b> {c.text}</li>)}
    </ul>
    <h3>{t.method.grounds.h}</h3>
    <p>{t.method.grounds.p1}</p>
    <p>{t.method.grounds.p2}</p>
    <p>{t.method.grounds.p3}</p>
    <p>{t.method.grounds.p4}</p>
    <Grounds labels={t.method.figures} />
    <p class="bu">{t.method.figures.grounds}</p>

    <h3>{t.method.contrast.h}</h3>
    <p>{t.method.contrast.p1}</p>
    <p>{t.method.contrast.p2}</p>
    <ContrastSpan labels={t.method.figures} />
    <p class="bu">{t.method.figures.contrast}</p>
    <ContrastTable labels={t.method.figures} />
    <h3>{t.method.glossary.h}</h3>
    <dl class="gloss">
      {t.method.glossary.terms.map(g => <><dt>{g.t}</dt><dd>{g.d}</dd></>)}
    </dl>
  </section>

  <section class="wrap schluss">
    <h2>{t.close.title}</h2>
    <p>{t.close.lede}</p>
    <p class="go">
      <a class="cta" href={path('/themes', lang)}>{t.themes.title}</a>
      <a href={path('/palette', lang)}>{t.palette.title}</a>
    </p>
  </section>
</Base>

<style>
  header { padding: var(--s6) 0 var(--s8); }
  .sub { font-size: 1.19rem; color: var(--subtle); margin: 0 0 var(--s6);
    max-width: 46ch; }
  .method p { max-width: 62ch; }
  /* Bildunterschrift: sagt, was die Grafik misst, und nennt die Grenze. */
  .bu { color: var(--ketu); font-size: .82rem; margin: var(--s3) 0 0;
    max-width: 46ch; }
  .cases { list-style: none; padding: 0; margin: var(--s5) 0 0;
    display: grid; gap: var(--s3); max-width: 62ch; }
  /* Der Strich statt eines Punkts: die Faelle sind Belege, keine Aufzaehlung. */
  .cases li { padding-left: var(--s4); border-left: 2px solid var(--hl_high); }
  .cases b { font-weight: 600; }
  .gloss { display: grid; gap: 0 var(--s5); margin: var(--s4) 0 0; max-width: 62ch; }
  @media (min-width: 34rem) { .gloss { grid-template-columns: 9rem 1fr; } }
  .gloss dt { font-weight: 600; }
  .gloss dd { margin: 0 0 var(--s4); color: var(--ketu); font-size: .93rem; }

  /* Einrichten ist die Hauptsache und traegt deshalb Flaeche, nicht nur Farbe. */
  .go { display: flex; align-items: center; gap: var(--s5); margin-top: var(--s5); }
  .go a { display: inline-flex; align-items: center; min-height: 44px; }
  .cta { display: inline-block; background: var(--shukra); color: var(--base);
    text-decoration: none; padding: var(--s3) var(--s5); border-radius: 999px;
    font-size: .95rem; }

  @media (prefers-contrast: more) {
    .gloss dd, .bu { color: var(--subtle); }
  }
</style>
