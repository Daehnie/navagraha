---
import Base from '../../layouts/Base.astro'
import Chart from '../../components/Chart.astro'
import ThemeSwitcher from '../../components/ThemeSwitcher.astro'
import CodePreview from '../../components/CodePreview.astro'
import { getLangFromUrl, useTranslations, path } from '../../i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---
<Base title={`Navagraha — ${t.tagline}`} description={t.lede}>
  <header class="wrap">
    <div class="hero">
      <div>
        <h1>{t.tagline}</h1>
        <p class="sub">{t.lede}</p>
        <ThemeSwitcher labels={t.variants} />
      </div>
      <div>
        <Chart />
        <p class="born">{t.chartCaption}</p>
      </div>
    </div>
  </header>

  <section class="wrap">
    <h2>{t.preview.title}</h2>
    <p>{t.preview.lede}</p>
    <CodePreview />
    <p class="go">
      <a class="cta" href={path('/themes', lang)}>{t.themes.title}</a>
      <a href={path('/palette', lang)}>{t.palette.title}</a>
    </p>
  </section>

  <section class="wrap method">
    <h2>{t.method.title}</h2>
    <p>{t.method.p1}</p>
    <h3>{t.method.h2}</h3><p>{t.method.p2}</p>
    <h3>{t.method.h3}</h3><p>{t.method.p3}</p>
    <h3>{t.method.h4}</h3><p>{t.method.p4}</p>
  </section>
</Base>

<style>
  header { padding: var(--s6) 0 var(--s8); }
  .hero { display: grid; gap: var(--s6); align-items: center; }
  @media (min-width: 52rem) { .hero { grid-template-columns: minmax(0,1fr) 20rem; gap: var(--s7); } }
  .sub { font-size: 1.12rem; color: var(--subtle); margin: 0 0 var(--s5); max-width: 40ch; }
  .born { font-size: .78rem; color: var(--ketu); letter-spacing: .012em;
    margin: var(--s5) 0 0; }
  .method p { max-width: 62ch; }
  /* Einrichten ist die Hauptsache und traegt deshalb Flaeche, nicht nur Farbe. */
  .go { display: flex; align-items: center; gap: var(--s5); margin-top: var(--s5); }
  .cta { display: inline-block; background: var(--shukra); color: var(--base);
    text-decoration: none; padding: var(--s3) var(--s5); border-radius: 999px;
    font-size: .95rem; }

  @media (prefers-contrast: more) {
    .born { color: var(--subtle); }
  }
</style>
