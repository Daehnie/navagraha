---
import Base from '../layouts/Base.astro'
import ThemeSwitcher from '../components/ThemeSwitcher.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Wie eingebaut wird, steht im README neben den Dateien — nicht hier. Die
// Seite sagt nur, wofuer es etwas gibt und wo es liegt.
const ports = [
  { key: 'tabby',  name: 'Tabby',      art: 'terminal', ordner: 'themes/tabby',
    datei: 'navagraha.yaml' },
  { key: 'iterm2', name: 'iTerm2',     art: 'terminal', ordner: 'themes/iterm2',
    datei: '4 × .itermcolors' },
  { key: 'vscode', name: 'VS Code',    art: 'editor',   ordner: 'themes/vscode/navagraha',
    datei: 'Extension' },
  { key: 'vim',    name: 'Vim & Neovim', art: 'editor', ordner: 'themes/vim',
    datei: 'navagraha.vim' },
  { key: 'bat',    name: 'bat',        art: 'terminal', ordner: 'themes/bat',
    datei: 'BAT_THEME=ansi' }
]
const repo = 'https://github.com/Daehnie/navagraha/tree/main/'
---
<Base title={`${t.themes.title} — Navagraha`} description={t.themes.lede}>
  <section class="wrap" style="border-top:0">
    <h2>{t.themes.title}</h2>
    <p>{t.themes.lede}</p>
    <p class="zahl mono">{t.themes.count.replace('{n}', String(ports.length))}</p>

    <ThemeSwitcher labels={t.variants} systemLabel={t.systemLabel} systemNote={t.systemNote} />

    <ul class="ports">
      {ports.map(p => (
        <li>
          <a href={repo + p.ordner}>
            <span class="zeichen" aria-hidden="true">
              {p.art === 'terminal' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2.5" y="4" width="19" height="16" rx="2.5" />
                  <path d="M7 9.5 L10.5 12.5 L7 15.5 M13 16 h4" stroke-linecap="round"
                        stroke-linejoin="round" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2.5" y="4" width="19" height="16" rx="2.5" />
                  <path d="M2.5 8.5 h19" />
                  <path d="M9.5 12 L7 14.5 L9.5 17 M14.5 12 L17 14.5 L14.5 17"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <span class="text">
              <span class="name">{p.name}</span>
              <span class="meta mono">{p.datei}</span>
            </span>
            <span class="art">{t.themes.kinds[p.art]}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="hinweis">{t.themes.readme}</p>
  </section>
</Base>

<style>
  .zahl { color: var(--shukra); font-size: .8rem; letter-spacing: .014em;
    margin: calc(var(--s5) * -1) 0 var(--s6); }
  .ports { list-style: none; padding: 0; margin: var(--s6) 0 0;
    display: grid; gap: var(--s3); }
  @media (min-width: 40rem) { .ports { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 62rem) { .ports { grid-template-columns: repeat(3, 1fr); } }

  /* Die ganze Karte ist der Griff, nicht nur ihr Name. */
  .ports a { display: flex; align-items: center; gap: var(--s3);
    padding: var(--s4); border: 1px solid var(--line); border-radius: 10px;
    background: var(--surface); text-decoration: none; color: var(--chandra);
    min-height: 44px; transition: border-color .2s, background-color .2s; }
  .ports a:hover { border-color: var(--shukra); background: var(--overlay); }
  .zeichen { flex: 0 0 auto; color: var(--ketu); display: block; }
  .zeichen svg { width: 1.5rem; height: 1.5rem; display: block; }
  .ports a:hover .zeichen { color: var(--shukra); }
  .text { display: grid; gap: .1rem; min-width: 0; }
  .name { font-size: 1rem; }
  .meta { color: var(--ketu); font-size: .7rem; letter-spacing: .014em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .art { margin-left: auto; color: var(--ketu); font-size: .72rem;
    letter-spacing: .03em; text-transform: uppercase; flex: 0 0 auto; }
  .hinweis { color: var(--ketu); font-size: .84rem; margin: var(--s5) 0 0;
    max-width: 54ch; }

  @media (prefers-contrast: more) {
    .zeichen, .meta, .art, .hinweis { color: var(--subtle); }
  }
</style>
