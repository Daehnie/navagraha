---
import palette from '../data/palette.json'
import '../styles/global.css'
import { getLangFromUrl, useTranslations, path, asset, stripBase, languages } from '../i18n/utils'

const { title, description } = Astro.props as { title: string; description?: string }
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const here = stripBase(Astro.url.pathname).replace(/^\/en/, '') || '/'

// Tiefe folgt dem Modus, nicht dem Geschmack: auf hellem Grund traegt ein
// Schatten, auf dunklem nicht — dort ist selbst reines Schwarz nur 1,13:1.
// Da faengt stattdessen eine helle Oberkante das Licht. Beide Werte sind auf
// dieselbe Sichtbarkeit gemessen, rund 1,25:1 gegen ihren Untergrund.
const TIEFE = {
  light: '0 1px 2px rgb(0 0 0 / .06), 0 8px 24px rgb(0 0 0 / .10)',
  dark:  'inset 0 1px 0 rgb(255 255 255 / .08)'
} as const

// CSS-Variablen aus der Palette erzeugen — eine einzige Quelle fuer Seite und Themes.
const vars = Object.entries(palette.variants).map(([key, v]) => {
  const decls = Object.entries(v.colors).map(([n, hex]) => `--${n}:${hex};`).join('')
  return `html[data-theme="${key}"]{${decls}--tiefe:${TIEFE[v.mode as 'light' | 'dark']};}`
}).join('\n')

const nav = [
  ['/', t.nav.home],
  ['/palette', t.nav.palette],
  ['/themes', t.nav.themes]
] as const
---
<!doctype html>
<html lang={lang} data-theme="swati">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={asset('/favicon-32.png')} sizes="32x32" />
  <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
  {Object.keys(languages).map(l => (
    <link rel="alternate" hreflang={l}
          href={new URL(path(here, l as any), Astro.site).toString()} />
  ))}
  <style set:html={vars}></style>
  <script is:inline>
    // Vor dem ersten Anstrich setzen, damit nichts aufblitzt.
    (() => {
      const hell = matchMedia('(prefers-color-scheme: light)')
      const vomSystem = () => hell.matches ? 'ushas' : 'swati'
      let v
      try { v = localStorage.getItem('navagraha') } catch {}
      document.documentElement.dataset.theme = v || vomSystem()
      // Ohne eigene Wahl folgt die Seite dem System auch waehrend der Sitzung.
      hell.addEventListener('change', () => {
        let gewaehlt
        try { gewaehlt = localStorage.getItem('navagraha') } catch {}
        if (!gewaehlt) document.dispatchEvent(
          new CustomEvent('navagraha:system', { detail: vomSystem() }))
      })
    })()
  </script>
</head>
<body>
  <div class="wrap top">
    <a class="brand" href={path('/', lang)}>
      <img src={asset('/favicon.svg')} alt="" width="24" height="24" />Navagraha
    </a>
    <nav>
      {nav.map(([p, label]) => (
        <a href={path(p, lang)}
           aria-current={here === p ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <span class="lang">
      {Object.entries(languages).map(([l, name], i) => (
        <>{i > 0 && ' / '}<a href={path(here, l as any)}
          aria-current={l === lang ? 'true' : undefined}>{name}</a></>
      ))}
    </span>
  </div>

  <slot />

  <footer class="wrap"><p>{t.footer}</p></footer>
</body>
</html>
