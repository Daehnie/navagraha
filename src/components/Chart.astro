---
// Nordindisches Rautendiagramm: Haeuser liegen fest, Zeichen rotieren.
// Lagna Tula, also steht Zeichen 7 im ersten Haus. Die Ziffer in einem Feld
// kann deshalb zweierlei meinen — der Schalter sagt, welches gerade gilt.
import palette from '../data/palette.json'
import { names, stand, type Sprache } from '../i18n/grahas'
const { labels } = Astro.props as { labels: any }
const lang: Sprache = Astro.currentLocale === 'en' ? 'en' : 'de'
const HOUSE = [[50,26],[25,13],[13,25],[26,50],[13,75],[25,87],
               [50,74],[75,87],[87,75],[74,50],[87,25],[75,13]]
const NUM   = [[50,15],[12,5],[5,12],[13,50],[5,88],[12,95],
               [50,88],[88,95],[95,88],[87,50],[95,12],[88,5]]
const OCC: Record<number, [string, string][]> = {
  0: [['guru','Gu']], 2: [['ketu','Ke']], 5: [['shukra','Śu']],
  7: [['surya','Sū'],['chandra','Ch'],['budha','Bu']],
  8: [['rahu','Ra']], 11: [['mangala','Ma'],['shani','Śa']]
}
let n = 0
---
<figure class="chartbox" data-mode="signs">
  <svg viewBox="0 0 100 100" class="chart" role="img" aria-label={labels.alt}>
    <g fill="none" stroke="var(--line)" stroke-width=".5">
      <rect x=".25" y=".25" width="99.5" height="99.5" />
      <path d="M0 0 L100 100 M100 0 L0 100 M50 0 L100 50 L50 100 L0 50 Z" />
    </g>
    {NUM.map(([x, y], i) => (
      <>
        <text x={x} y={y} class="sg num">{((6 + i) % 12) + 1}</text>
        <text x={x} y={y} class="hs num">{i + 1}</text>
      </>
    ))}
    {HOUSE.map(([x, y], h) => (OCC[h] ?? []).map(([key, abbr], j, all) => {
      const dy = (j - (all.length - 1) / 2) * 6.4
      const delay = (n++) * 90
      return <g class="gh" data-key={key}
                style={`--c:var(--${key});animation-delay:${delay}ms`}>
        <rect x={x - 7} y={y + dy - 5} width="14" height="6.6" rx="1.4" />
        <text x={x} y={y + dy} style="fill:var(--c)">{abbr}</text>
      </g>
    }))}
  </svg>
  <div class="ctl" role="radiogroup" aria-label={labels.group}>
    <button role="radio" data-mode="signs" aria-checked="true">{labels.signs}</button>
    <button role="radio" data-mode="houses" aria-checked="false">{labels.houses}</button>
  </div>
  <figcaption class="note" aria-live="polite">{labels.signsNote}</figcaption>
  <h3 class="vh" id="chart-liste">{labels.listTitle}</h3>
  <ul class="vh" aria-labelledby="chart-liste">
    {palette.grahas.map(g => (
      <li>{names[g.key][lang]} ({g.sa}): {stand(g, lang)}</li>
    ))}
  </ul>
</figure>

<script is:inline define:vars={{ notes: { signs: labels.signsNote, houses: labels.housesNote } }}>
  // Dasselbe Muster wie der Variantenschalter: eine Radiogruppe, ein Halt in
  // der Tab-Reihenfolge, Pfeiltasten wandern mit Umschlag an den Enden.
  const box = document.querySelector('.chartbox')
  const note = box.querySelector('.note')
  const knoepfe = [...box.querySelectorAll('.ctl button')]

  function zeige(modus) {
    box.dataset.mode = modus
    note.textContent = notes[modus]
    knoepfe.forEach(b => {
      const an = b.dataset.mode === modus
      b.setAttribute('aria-checked', String(an))
      b.tabIndex = an ? 0 : -1
    })
  }

  const sicht = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return
    box.classList.add('rein')
    sicht.disconnect()
  }, { threshold: .25 })
  sicht.observe(box)

  // Ein Graha im Diagramm ist ein Zusatzweg zur Wahl, kein eigener Zustand:
  // die Reihe unter dem Diagramm fuehrt sie, hier wird nur angestossen.
  box.querySelectorAll('.gh').forEach(g => g.addEventListener('click', () =>
    document.dispatchEvent(new CustomEvent('navagraha:graha', { detail: g.dataset.key }))))
  document.addEventListener('navagraha:graha', e => {
    box.dataset.graha = e.detail
    box.querySelectorAll('.gh').forEach(g =>
      g.classList.toggle('an', g.dataset.key === e.detail))
  })

  const SCHRITT = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }
  knoepfe.forEach((b, i) => {
    b.tabIndex = b.dataset.mode === box.dataset.mode ? 0 : -1
    b.addEventListener('click', () => zeige(b.dataset.mode))
    b.addEventListener('keydown', e => {
      const d = SCHRITT[e.key]
      if (!d) return
      e.preventDefault()
      const ziel = knoepfe[(i + d + knoepfe.length) % knoepfe.length]
      zeige(ziel.dataset.mode)
      ziel.focus()
    })
  })
</script>

<style>
  .chartbox { margin: 0; }
  .chart { width: 100%; max-width: var(--chart-max, 20rem); display: block; }
  .chart .num { font-size: 3.1px; fill: var(--ketu); text-anchor: middle;
    font-family: ui-monospace, Menlo, monospace; }
  .chartbox[data-mode="signs"] .hs,
  .chartbox[data-mode="houses"] .sg { display: none; }
  /* Die Haeuserziffern gehoeren zum Lagna, nicht zum Zodiak: eigener Ton. */
  .chartbox[data-mode="houses"] .hs { fill: var(--guru); }
  .chart .gh text { font-size: 5.4px; text-anchor: middle; font-weight: 600; }
  .chart .gh { cursor: pointer; }
  /* Das Diagramm steht nicht mehr im ersten Bild. Die Animation laeuft
     deshalb erst, wenn es in den Blick kommt — ohne Skript bleibt sie aus,
     und die Kuerzel stehen einfach da. */
  .chartbox.rein .gh { animation: rise .5s ease-out backwards; }
  @keyframes rise { from { opacity: 0; transform: translateY(2px); } }
  /* Der Gewaehlte wird hervorgehoben, die anderen nicht abgewertet: ein
     gedaempftes Kuerzel waere Text unter 4,5:1, und das gilt hier auch. */
  .chart .gh rect { fill: transparent; transition: fill .2s; }
  .chart .gh:hover rect { fill: var(--hl_med); }
  .chart .gh.an rect { fill: color-mix(in oklab, var(--c) 22%, transparent);
    stroke: var(--c); stroke-width: .4; }

  /* Sieht aus wie der Variantenschalter, weil er sich genauso verhaelt. */
  .ctl { display: flex; gap: var(--s2); margin-top: var(--s4);
    max-width: var(--chart-max, 20rem); }
  .ctl button { flex: 1; background: var(--surface); color: var(--subtle);
    border: 1px solid var(--line); border-radius: 999px; font: inherit;
    font-size: .84rem; cursor: pointer; padding: var(--s2) var(--s3);
    min-height: 44px; transition: border-color .2s, color .2s; }
  .ctl button:hover { border-color: var(--ketu); color: var(--chandra); }
  .ctl button:active { border-color: var(--ketu); color: var(--chandra);
    transform: scale(.97); transition: transform 100ms ease-out; }
  .ctl button[aria-checked="true"] { border-color: var(--shukra);
    color: var(--chandra_b); }
  .note { font-size: .78rem; color: var(--ketu); letter-spacing: .012em;
    margin: var(--s3) 0 0; max-width: 34ch; }

  @media (prefers-contrast: more) {
    .note { color: var(--subtle); }
    .ctl button { border-color: var(--subtle); }
  }
</style>
