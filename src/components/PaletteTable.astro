---
import palette from '../data/palette.json'
import { roles, names, hues, dignities, stand } from '../i18n/grahas'
const { t } = Astro.props as { t: any }
const variants = Object.entries(palette.variants)
const lang = Astro.currentLocale === 'en' ? 'en' : 'de'
// Welche Werte hier stehen, entscheidet palette.json — nur die Beschriftung
// liegt hier, weil sie Oberflaeche ist und keine Palettendaten.
const neutralLabels: Record<string, { de: string; en: string }> = {
  base:    { de: 'Grund',                en: 'Ground' },
  surface: { de: 'Fläche',               en: 'Surface' },
  overlay: { de: 'Auflage',              en: 'Overlay' },
  subtle:  { de: 'Chandra gedämpft',     en: 'Chandra, damped' },
  hl_low:  { de: 'Hervorhebung schwach', en: 'Highlight, low' },
  hl_med:  { de: 'Hervorhebung mittel',  en: 'Highlight, medium' },
  hl_high: { de: 'Auswahl',              en: 'Selection' },
  line:    { de: 'Linie und Rahmen',     en: 'Line and border' }
}
const neutrals = palette.neutrals.map(key => [key, neutralLabels[key]] as const)
---
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader">{t.palette.graha}</th>
      <th role="columnheader">{t.palette.role}</th>
      <th role="columnheader" class="so">{t.palette.source}</th>
      <th role="columnheader">{variants.map(([, v]) => v.label).join(' · ')}</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {palette.grahas.map(g => (
      <tr role="row">
        <th role="rowheader" scope="row">
          <span class="dot" style={`background:var(--${g.key})`}></span>
          <span class="nm">
            <span class="gn">{names[g.key][lang]}</span>
            <span class="sa">{g.sa}</span>
          </span>
        </th>
        <td role="cell" class="ro">{roles[g.key][lang]}</td>
        <td role="cell" class="so">
          {hues[g.key][lang]} · {stand(g, lang)}
          {g.dignities.length > 0 && (
            <span class="dg">{g.dignities.map(d => dignities[d][lang]).join(', ')}</span>
          )}
        </td>
        <td role="cell" class="hx">{variants.map(([, v]) => (
          <button data-copy={v.colors[g.key]} data-toast={v.colors[g.key]}
                  style={`--c:${v.colors[g.key]}`}
                  title={`${v.label}: ${v.colors[g.key]}`}
                  aria-label={`${v.label} ${v.colors[g.key]} ${t.copy}`}>
            <i></i><code>{v.colors[g.key]}</code>
          </button>
        ))}</td>
      </tr>
    ))}
  </tbody>
</table>

<h2 class="ground">{t.palette.groundTitle}</h2>
<p>{t.palette.groundLede}</p>
<table role="table">
  <tbody role="rowgroup">
    {neutrals.map(([key, label]) => (
      <tr role="row">
        <th role="rowheader" scope="row">
          <span class="dot" style={`background:var(--${key})`}></span>
          <span class="gn">{label[lang]}</span>
        </th>
        <td role="cell" class="ro" colspan="2"><code>{key}</code></td>
        <td role="cell" class="hx">{variants.map(([, v]) => (
          <button data-copy={v.colors[key]} data-toast={v.colors[key]}
                  style={`--c:${v.colors[key]}`}
                  title={`${v.label}: ${v.colors[key]}`}
                  aria-label={`${v.label} ${v.colors[key]} ${t.copy}`}>
            <i></i><code>{v.colors[key]}</code>
          </button>
        ))}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  table { width: 100%; border-collapse: collapse; }
  table:first-of-type { margin-top: var(--s6); }
  th, td { text-align: left; vertical-align: top;
    padding: var(--s3) var(--s3) var(--s3) 0;
    border-bottom: 1px solid var(--hl_low); font-weight: 400; }
  thead th { color: var(--ketu); font-size: .74rem; letter-spacing: .012em;
    border-bottom-color: var(--hl_high); }
  .dot { width: .8rem; height: .8rem; border-radius: 50%; display: inline-block;
    vertical-align: -1px; margin-right: var(--s2); }
  .ground { margin-top: var(--s7); }
  .gn { font-size: 1rem; }
  /* Planetenname oben, Sanskritname darunter: der Punkt bleibt an der ersten Zeile. */
  .nm { display: inline-block; vertical-align: top; }
  .nm .gn, .nm .sa { display: block; }
  .sa { color: var(--ketu); font-size: .76rem; letter-spacing: .014em; }
  .ro { font-size: .9rem; }
  .so { color: var(--ketu); font-size: .78rem; letter-spacing: .012em; max-width: 24ch; }
  .dg { display: block; color: var(--shukra); }
  .hx { white-space: nowrap; }
  .hx button { display: inline-flex; align-items: center; gap: var(--s1); background: none;
    border: 0; padding: var(--s1); margin: var(--s1) 0; border-radius: 4px;
    cursor: pointer; font: inherit; color: var(--ketu); }
  .hx button:hover { background: var(--hl_med); color: var(--chandra); }
  /* Rueckmeldung liegt auf dem Druck, nicht auf dem Loslassen. */
  .hx button:active { background: var(--hl_med); color: var(--chandra);
    transform: scale(.97); transition: transform 100ms ease-out; }
  .hx button i { width: .74rem; height: .74rem; border-radius: 2px; background: var(--c);
    display: block; box-shadow: 0 0 0 1px var(--line); }
  .hx code { font-size: .69rem; letter-spacing: .016em; }
  /* Unter 46rem wird aus jeder Zeile eine Karte: vier Spalten passen dort
     nicht nebeneinander, und die Stand- und Hexwerte auszublenden hiesse,
     die Begruendung des Schemas nur am Schreibtisch zu zeigen. display:block
     nimmt der Tabelle ihre Semantik — die role-Attribute geben sie zurueck. */
  @media (max-width: 46rem) {
    table, tbody, tr, th, td { display: block; }
    thead { display: none; }
    tr { padding: var(--s4) 0; border-bottom: 1px solid var(--hl_low); }
    th, td { border: 0; padding: 0; }
    .ro { margin-top: var(--s1); }
    .so { max-width: none; margin-top: var(--s1); }
    .dg { display: inline; margin-left: var(--s2); }
    .hx { margin-top: var(--s3); display: flex; flex-wrap: wrap; gap: var(--s2);
      white-space: normal; }
    .hx button { margin: 0; min-height: 44px; padding-inline: var(--s2); }
  }
  @media (prefers-contrast: more) {
    .so, .sa, thead th { color: var(--subtle); }
    th, td { border-bottom-color: var(--hl_high); }
  }
</style>
