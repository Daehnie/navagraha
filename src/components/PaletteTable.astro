---
import palette from '../data/palette.json'
const { t } = Astro.props as { t: any }
const variants = Object.entries(palette.variants)
const roles: Record<string, { de: string; en: string }> = {
  surya:   { de: 'Zahlen und Konstanten', en: 'Numbers and constants' },
  chandra: { de: 'Bezeichner und Grundtext', en: 'Identifiers and body text' },
  mangala: { de: 'Schlüsselwörter und Steuerfluss', en: 'Keywords and control flow' },
  budha:   { de: 'Zeichenketten', en: 'Strings' },
  guru:    { de: 'Funktionen und Selektoren', en: 'Functions and selectors' },
  shukra:  { de: 'Typen und Eigenschaftsnamen', en: 'Types and property names' },
  shani:   { de: 'Operatoren', en: 'Operators' },
  rahu:    { de: 'Präprozessor, At-Rules, Tags', en: 'Preprocessor, at-rules, tags' },
  ketu:    { de: 'Kommentare', en: 'Comments' }
}
// Der Sanskritname allein sagt niemandem, welcher Planet gemeint ist. Rahu und
// Ketu haben keinen: sie sind die beiden Knoten der Mondbahn.
const names: Record<string, { de: string; en: string }> = {
  surya:   { de: 'Sonne', en: 'Sun' },
  chandra: { de: 'Mond', en: 'Moon' },
  mangala: { de: 'Mars', en: 'Mars' },
  budha:   { de: 'Merkur', en: 'Mercury' },
  guru:    { de: 'Jupiter', en: 'Jupiter' },
  shukra:  { de: 'Venus', en: 'Venus' },
  shani:   { de: 'Saturn', en: 'Saturn' },
  rahu:    { de: 'aufsteigender Mondknoten', en: 'ascending lunar node' },
  ketu:    { de: 'absteigender Mondknoten', en: 'descending lunar node' }
}
const hues: Record<string, { de: string; en: string }> = {
  surya:   { de: 'kupferrot', en: 'copper red' },
  chandra: { de: 'weiß', en: 'white' },
  mangala: { de: 'blutrot', en: 'blood red' },
  budha:   { de: 'grasgrün', en: 'grass green' },
  guru:    { de: 'goldgelb', en: 'golden yellow' },
  shukra:  { de: 'weiß-schillernd', en: 'iridescent white' },
  shani:   { de: 'dunkelblau', en: 'dark blue' },
  rahu:    { de: 'rauchig', en: 'smoky' },
  ketu:    { de: 'aschgrau', en: 'ash grey' }
}
const signs: Record<string, { de: string; en: string }> = {
  Vrishabha: { de: 'Stier', en: 'Taurus' },
  Mithuna:   { de: 'Zwillinge', en: 'Gemini' },
  Kanya:     { de: 'Jungfrau', en: 'Virgo' },
  Tula:      { de: 'Waage', en: 'Libra' },
  Dhanu:     { de: 'Schütze', en: 'Sagittarius' },
  Mina:      { de: 'Fische', en: 'Pisces' }
}
// Diese vier sind der Grund, warum manche Farben kraeftiger ausfallen als
// andere. Sie stehen deshalb abgesetzt und nicht im Fliesstext der Zelle.
const dignities: Record<string, { de: string; en: string }> = {
  exalted:    { de: 'exaltiert', en: 'exalted' },
  retrograde: { de: 'retrograd', en: 'retrograde' },
  digbala:    { de: 'Dig Bala', en: 'dig bala' },
  atmakaraka: { de: 'Atmakaraka', en: 'atmakaraka' }
}
const ord = (n: number, l: string) => l === 'en'
  ? `${n}${['th','st','nd','rd'][n % 10 < 4 && (n < 11 || n > 13) ? n % 10 : 0]} house`
  : `${n}. Haus`
const lang = Astro.currentLocale === 'en' ? 'en' : 'de'
// Welche Werte hier stehen, entscheidet palette.json — nur die Beschriftung
// liegt hier, weil sie Oberflaeche ist und keine Palettendaten.
const neutralLabels: Record<string, { de: string; en: string }> = {
  base:    { de: 'Grund',                en: 'Ground' },
  surface: { de: 'Fläche',               en: 'Surface' },
  overlay: { de: 'Auflage',              en: 'Overlay' },
  subtle:  { de: 'Chandra gedämpft',     en: 'Chandra, damped' },
  hl_low:  { de: 'Hervorhebung schwach', en: 'Highlight, low' },
  hl_med:  { de: 'Hervorhebung mittel',  en: 'Highlight, medium' },
  hl_high: { de: 'Auswahl',              en: 'Selection' }
}
const neutrals = palette.neutrals.map(key => [key, neutralLabels[key]] as const)
---
<table>
  <thead>
    <tr>
      <th>{t.palette.graha}</th>
      <th>{t.palette.role}</th>
      <th class="so">{t.palette.source}</th>
      <th>{variants.map(([, v]) => v.label).join(' · ')}</th>
    </tr>
  </thead>
  <tbody>
    {palette.grahas.map(g => (
      <tr>
        <th scope="row">
          <span class="dot" style={`background:var(--${g.key})`}></span>
          <span class="nm">
            <span class="gn">{names[g.key][lang]}</span>
            <span class="sa">{g.sa}</span>
          </span>
        </th>
        <td class="ro">{roles[g.key][lang]}</td>
        <td class="so">
          {hues[g.key][lang]} · {signs[g.sign][lang]}, {ord(g.house, lang)}
          {g.dignities.length > 0 && (
            <span class="dg">{g.dignities.map(d => dignities[d][lang]).join(', ')}</span>
          )}
        </td>
        <td class="hx">{variants.map(([, v]) => (
          <button data-hex={v.colors[g.key]} style={`--c:${v.colors[g.key]}`}
                  title={`${v.label}: ${v.colors[g.key]}`}
                  aria-label={`${v.label} ${v.colors[g.key]} ${t.palette.copy}`}>
            <i></i><code>{v.colors[g.key]}</code>
          </button>
        ))}</td>
      </tr>
    ))}
  </tbody>
</table>

<h2 class="ground">{t.palette.groundTitle}</h2>
<p>{t.palette.groundLede}</p>
<table>
  <tbody>
    {neutrals.map(([key, label]) => (
      <tr>
        <th scope="row">
          <span class="dot" style={`background:var(--${key})`}></span>
          <span class="gn">{label[lang]}</span>
        </th>
        <td class="ro" colspan="2"><code>{key}</code></td>
        <td class="hx">{variants.map(([, v]) => (
          <button data-hex={v.colors[key]} style={`--c:${v.colors[key]}`}
                  title={`${v.label}: ${v.colors[key]}`}
                  aria-label={`${v.label} ${v.colors[key]} ${t.palette.copy}`}>
            <i></i><code>{v.colors[key]}</code>
          </button>
        ))}</td>
      </tr>
    ))}
  </tbody>
</table>

<div id="copied" role="status" aria-live="polite"></div>

<script is:inline define:vars={{ word: t.palette.copied }}>
  const toast = document.getElementById('copied')
  let timer
  document.querySelectorAll('.hx button').forEach(b => {
    b.addEventListener('click', async () => {
      const hex = b.dataset.hex
      // Erst zeigen, dann kopieren: das Clipboard-Promise gehoert nicht auf den Eingabepfad.
      toast.textContent = `${hex} ${word}`
      toast.classList.add('on')
      clearTimeout(timer)
      timer = setTimeout(() => toast.classList.remove('on'), 1400)
      try { await navigator.clipboard.writeText(hex) }
      catch { toast.textContent = hex }
    })
  })
</script>

<style>
  table { width: 100%; border-collapse: collapse; }
  table:first-of-type { margin-top: var(--s6); }
  th, td { text-align: left; vertical-align: top;
    padding: var(--s3) var(--s3) var(--s3) 0;
    border-bottom: 1px solid var(--hl_low); font-weight: 400; }
  thead th { color: var(--ketu); font-size: .74rem; letter-spacing: .012em;
    border-bottom-color: var(--hl_high); }
  .dot { width: .8rem; height: .8rem; border-radius: 50%; display: inline-block;
    vertical-align: -1px; margin-right: var(--s2); }
  .ground { margin-top: var(--s7); }
  .gn { font-size: 1rem; }
  /* Planetenname oben, Sanskritname darunter: der Punkt bleibt an der ersten Zeile. */
  .nm { display: inline-block; vertical-align: top; }
  .nm .gn, .nm .sa { display: block; }
  .sa { color: var(--ketu); font-size: .76rem; letter-spacing: .014em; }
  .ro { font-size: .9rem; }
  .so { color: var(--ketu); font-size: .78rem; letter-spacing: .012em; max-width: 24ch; }
  .dg { display: block; color: var(--shukra); }
  .hx { white-space: nowrap; }
  .hx button { display: inline-flex; align-items: center; gap: var(--s1); background: none;
    border: 0; padding: var(--s1); margin: var(--s1) 0; border-radius: 4px;
    cursor: pointer; font: inherit; color: var(--ketu); }
  .hx button:hover { background: var(--hl_med); color: var(--chandra); }
  /* Rueckmeldung liegt auf dem Druck, nicht auf dem Loslassen. */
  .hx button:active { background: var(--hl_med); color: var(--chandra);
    transform: scale(.97); transition: transform 100ms ease-out; }
  .hx button i { width: .74rem; height: .74rem; border-radius: 2px; background: var(--c);
    display: block; box-shadow: 0 0 0 1px var(--hl_high); }
  .hx code { font-size: .69rem; letter-spacing: .016em; }
  @media (max-width: 46rem) { .so { display: none; } .hx code { display: none; } }
  /* Schwebende Chrome ueber Inhalt: Glas, das ankommt, nicht eine Flaeche,
     die eingeblendet wird. Unschaerfe und Groesse laufen zusammen hoch. */
  #copied { position: fixed; left: 50%; bottom: var(--s5);
    transform: translateX(-50%) scale(.96);
    background: color-mix(in oklab, var(--overlay) 72%, transparent);
    -webkit-backdrop-filter: blur(0px) saturate(100%);
    backdrop-filter: blur(0px) saturate(100%);
    color: var(--chandra);
    border: 1px solid color-mix(in oklab, var(--hl_high) 60%, transparent);
    padding: var(--s2) var(--s4); border-radius: 999px; font-size: .8rem;
    letter-spacing: .012em; opacity: 0;
    pointer-events: none;
    transition: opacity .2s, transform .2s, backdrop-filter .2s; }
  #copied.on { opacity: 1; transform: translateX(-50%) scale(1);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%); }

  /* Ohne Transluzenz wird aus dem Glas eine deckende Flaeche; das
     Materialisieren faellt weg, das Einblenden bleibt. */
  @media (prefers-reduced-transparency: reduce) {
    #copied, #copied.on { background: var(--overlay); border-color: var(--hl_high);
      -webkit-backdrop-filter: none; backdrop-filter: none; }
  }

  @media (prefers-contrast: more) {
    .so, .sa, thead th { color: var(--subtle); }
    th, td { border-bottom-color: var(--hl_high); }
  }
</style>
