---
import palette from '../data/palette.json'
const { labels, systemLabel, systemNote } = Astro.props as {
  labels: Record<string, string>; systemLabel: string; systemNote: string
}
const variants = Object.entries(palette.variants)
const v = palette.variants as Record<string, { colors: Record<string, string> }>
---
<div class="tabs" role="radiogroup" aria-label="Variante">
  {variants.map(([key, v]) => (
    <button role="radio" data-v={key} aria-checked="false">
      <span class="sw">
        <i style={`background:${v.colors.base}`}></i>
        <i style={`background:${v.colors.shukra}`}></i>
        <i style={`background:${v.colors.guru}`}></i>
      </span>{v.label}
    </button>
  ))}
  <button role="radio" data-system aria-checked="false">
    <span class="sw">
      <i style={`background:${v.ushas.colors.base}`}></i>
      <i style={`background:${v.swati.colors.base}`}></i>
    </span>{systemLabel}
  </button>
</div>
<p class="vnote" id="vnote"></p>

<script is:inline define:vars={{ labels, systemNote }}>
  const tabs = document.querySelectorAll('.tabs button')
  const note = document.getElementById('vnote')
  const vomSystem = () =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'ushas' : 'swati'

  function zeige(v, folgtSystem) {
    document.documentElement.dataset.theme = v
    tabs.forEach(b => {
      const an = folgtSystem ? b.hasAttribute('data-system') : b.dataset.v === v
      b.setAttribute('aria-checked', String(an))
      // Roving Tabindex: die Gruppe ist ein Halt in der Tab-Reihenfolge, nicht fuenf.
      b.tabIndex = an ? 0 : -1
    })
    if (note) note.textContent = folgtSystem ? systemNote : (labels[v] ?? '')
  }

  function waehle(b) {
    if (b.hasAttribute('data-system')) {
      try { localStorage.removeItem('navagraha') } catch {}
      zeige(vomSystem(), true)
    } else {
      try { localStorage.setItem('navagraha', b.dataset.v) } catch {}
      zeige(b.dataset.v, false)
    }
  }

  const SCHRITT = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => waehle(b))
    b.addEventListener('keydown', e => {
      const d = SCHRITT[e.key]
      if (!d) return
      e.preventDefault()
      // In einer Radiogruppe folgt die Wahl dem Fokus, und die Enden schliessen sich.
      const ziel = tabs[(i + d + tabs.length) % tabs.length]
      waehle(ziel)
      ziel.focus()
    })
  })

  // Wechselt das System, folgt die Seite mit — solange nichts gewaehlt wurde.
  document.addEventListener('navagraha:system', e => zeige(e.detail, true))

  let gespeichert
  try { gespeichert = localStorage.getItem('navagraha') } catch {}
  zeige(gespeichert || vomSystem(), !gespeichert)
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .tabs button { display: inline-flex; align-items: center; gap: var(--s2);
    background: var(--surface); color: var(--subtle);
    border: 1px solid var(--hl_med); border-radius: 999px;
    padding: var(--s2) var(--s3) var(--s2) var(--s2); font: inherit; font-size: .84rem;
    cursor: pointer; transition: border-color .2s, color .2s; }
  .tabs button:hover { border-color: var(--hl_high); color: var(--chandra); }
  /* Rueckmeldung liegt auf dem Druck, nicht auf dem Loslassen. */
  .tabs button:active { border-color: var(--hl_high); color: var(--chandra);
    transform: scale(.97); transition: transform 100ms ease-out; }
  .tabs button[aria-checked="true"] { border-color: var(--shukra); color: var(--chandra_b); }
  .sw { display: inline-flex; }
  .sw i { width: .62rem; height: .95rem; display: block; }
  .sw i:first-child { border-radius: 3px 0 0 3px; }
  .sw i:last-child { border-radius: 0 3px 3px 0; }
  .vnote { color: var(--ketu); font-size: .86rem; margin: var(--s4) 0 0;
    max-width: 44ch; min-height: 3rem; }

  @media (prefers-contrast: more) {
    .vnote { color: var(--subtle); }
    .tabs button { border-color: var(--hl_high); }
  }
</style>
