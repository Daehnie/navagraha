  "tokenColors": [
    {
      "name": "Ketu – Kommentare",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#595e66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Chandra – Bezeichner, Variablen",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name",
        "support.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#232933"
      }
    },
    {
      "name": "Mangala – Schluesselwoerter, Steuerfluss",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a83632"
      }
    },
    {
      "name": "Budha – Zeichenketten",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "constant.other.symbol",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#216b33"
      }
    },
    {
      "name": "Guru – Funktionen, Selektoren",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.section",
        "markup.heading",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#775a00"
      }
    },
    {
      "name": "Shani – Operatoren",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#3c5d9d"
      }
    },
    {
      "name": "Chandra – Satzzeichen, die wie Operatoren heissen",
      "scope": [
        "keyword.operator.type.annotation",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#232933"
      }
    },
    {
      "name": "Surya – Zahlen, Konstanten",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "keyword.other.unit",
        "support.constant"
      ],
      "settings": {
        "foreground": "#944b00"
      }
    },
    {
      "name": "Shukra – Typen, Klassen, Eigenschaftsnamen",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "meta.type.annotation",
        "storage.type.class",
        "support.type.property-name",
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#006a6b"
      }
    },
    {
      "name": "Rahu – Praeprozessor, At-Rules, Tags",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.at-rule",
        "entity.name.tag",
        "constant.character.escape",
        "meta.decorator",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6e547d"
      }
    },
    {
      "name": "Mangala – ungueltig",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a83632",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Ketu – veraltet",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#595e66",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Budha – eingefuegt",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#216b33"
      }
    },
    {
      "name": "Markup – kursiv",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#232933",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup – fett",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#14181f",
        "fontStyle": "bold"
      }
    }
  ]
}